# Database Configuration
DB_USER=eduuser
DB_PASSWORD=your_secure_db_password_here

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_admin_password_here
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
# Optional override. Use exact deployed origins; do not use wildcard tunnel domains.
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_ISSUER_URL=
KEYCLOAK_ALLOWED_REDIRECT_ORIGINS=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_USE_SSL=true
MINIO_CERTS_DIR=./minio/certs

# Centrifugo Configuration
CENTRIFUGO_SECRET=your_centrifugo_secret_key_here
CENTRIFUGO_API_KEY=your_centrifugo_api_key_here

# NTFY Configuration
NTFY_BASE_URL=http://localhost:2586
NTFY_PUBLIC_URL=http://localhost:2586
NTFY_TOPIC_PREFIX=tusyen
NTFY_ENABLED=true
NTFY_TIMEOUT_MS=2500
# Optional, only if you configure ntfy auth users/tokens.
NTFY_ACCESS_TOKEN=
NTFY_USERNAME=
NTFY_PASSWORD=
PUBLIC_APP_URL=http://localhost

# API Configuration
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=true
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT_MAX=6
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_KEYCLOAK_START_RATE_LIMIT_MAX=20
AUTH_KEYCLOAK_START_RATE_LIMIT_WINDOW_SECONDS=60
DEMO_ADMIN_LOGIN_ENABLED=false
PUBLIC_ADMIN_REGISTRATION_ENABLED=false
ALLOW_GUEST_QUIZ_JOIN=false

# SSL/Domain (for Caddy)
CADDY_SITE_ADDRESS=your-domain.com
