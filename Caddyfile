# Caddy reverse proxy configuration.
# Production must use a stable DNS name, for example:
# CADDY_SITE_ADDRESS=tusyen.example.com

(tusyen_routes) {
	root * /srv/web-v2

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# Health check endpoint
	respond /health 200

	# API routes
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# WebSocket routes for classroom and live quiz sessions
	handle /ws/* {
		reverse_proxy api:3000
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# Internal service surfaces are intentionally not exposed through Caddy.
	handle /connection/* {
		respond 404
	}

	handle /centrifugo/* {
		respond 404
	}

	handle /minio/* {
		respond 404
	}

	handle /minio-console/* {
		respond 404
	}

	# Web app
	handle {
		try_files {path} /index.html
		file_server
	}
}

{$CADDY_SITE_ADDRESS:http://localhost} {
	import tusyen_routes
}
